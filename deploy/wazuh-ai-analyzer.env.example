# Wazuh AI Analyzer - settings (EnvironmentFile of the unit). Copy to
# /etc/wazuh-ai-analyzer.env with mode 0600. Every variable is documented in
# docs/configuration.md; only the ones that deployments usually set are listed here.
#
# The Gemini API key does NOT belong here: put it into /etc/wazuh-ai-analyzer/gemini
# (mode 0600, owner root); systemd hands it to the service (LoadCredential=).

# Dashboard login. Without a hash the dashboard answers 503.
# Create the hash without putting the password on a command line:
#   read -rs PW; printf %s "$PW" | /opt/wazuh-ai-analyzer/current/venv/bin/python \
#     -c 'import sys; from werkzeug.security import generate_password_hash as g; print(g(sys.stdin.read()))'
DASHBOARD_USER=admin
DASHBOARD_PASSWORD_HASH=

# Where the dashboard listens. The cookies are Secure by default: put an HTTPS proxy in
# front, or set SESSION_COOKIE_SECURE=false for a test over plain http.
LISTEN_HOST=127.0.0.1
PORT=8765
TRUSTED_PROXY_HOPS=0

# Wazuh alerts (the unit makes /var/ossec/logs/alerts read-only for the service; add a
# ReadOnlyPaths= drop-in when the log lives elsewhere).
WAZUH_ALERTS_LOG=/var/ossec/logs/alerts/alerts.json
# The data directory is the only path the unit lets the service write to.
DB_PATH=/opt/wazuh-ai-analyzer/data/analyses.db

MIN_LEVEL=5
BATCH_MAX=25
BATCH_TIMEOUT=300
# INFRA_CONTEXT="a self-hosted Linux server environment"
