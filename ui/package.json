{
  "name": "wazuh-ai-analyzer-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard of the Wazuh AI Analyzer: a plain Vite SPA (Svelte 5) on the kern design kit.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "playwright test -c e2e/screenshots.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@mozra-the-great/kern": "https://github.com/Mozra-the-great/kern/releases/download/v0.12.3/mozra-the-great-kern-0.12.3.tgz",
    "svelte": "5.58.0"
  }
}
